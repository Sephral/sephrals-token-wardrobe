<div class="stw-shell">
  <header class="stw-head">
    <div class="stw-who">
      <span class="stw-who-img stw-stage-icon{{#if active}} live{{/if}}"><i class="fa-solid fa-masks-theater" inert></i></span>
      <div class="stw-who-text">
        <strong>{{localize "STW.Stage.title"}}</strong>
        <small>{{subtitle}}</small>
      </div>
    </div>
    <div class="stw-toolbar">
      <label class="stw-inline" data-tooltip="{{localize "STW.Stage.backdropHint"}}">{{localize "STW.Stage.backdropLabel"}}
        <select name="backdrop">{{#each shadings}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <button type="button" class="stw-danger" data-action="closeStage" {{#unless active}}disabled{{/unless}}
        data-tooltip="{{localize "STW.Stage.closeHint"}}"><i class="fa-solid fa-circle-xmark" inert></i> {{localize "STW.Stage.close"}}</button>
    </div>
  </header>

  <section class="stw-stage-add">
    <select name="addActor" aria-label="{{localize "STW.Stage.pick"}}" {{#if full}}disabled{{/if}}>
      <option value="">{{localize "STW.Stage.pick"}}</option>
      {{#if withOutfits.length}}<optgroup label="{{localize "STW.Stage.withOutfits"}}">
        {{#each withOutfits}}<option value="{{id}}">{{name}}</option>{{/each}}</optgroup>{{/if}}
      {{#if others.length}}<optgroup label="{{localize "STW.Stage.others"}}">
        {{#each others}}<option value="{{id}}">{{name}}</option>{{/each}}</optgroup>{{/if}}
    </select>
    <button type="button" class="stw-primary" data-action="addActor" {{#if full}}disabled{{/if}}><i class="fa-solid fa-user-plus" inert></i> {{localize "STW.Stage.add"}}</button>
    <button type="button" data-action="addSelected" {{#unless hasTokens}}disabled{{/unless}}
      data-tooltip="{{localize "STW.Stage.addSelectedHint"}}"><i class="fa-solid fa-user-group" inert></i> {{localize "STW.Stage.addSelected"}}</button>
  </section>

  <section class="stw-backdrops">
    <div class="stw-backdrops-head">
      <strong><i class="fa-solid fa-image" inert></i> {{localize "STW.Backdrop.title"}}</strong>
      <label class="stw-inline" data-tooltip="{{localize "STW.Backdrop.tintHint"}}">{{localize "STW.Backdrop.tint"}}
        <select name="tint" {{#unless hasBackdrop}}disabled{{/unless}}>{{#each tints}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="stw-inline" data-tooltip="{{localize "STW.Backdrop.panHint"}}"><input type="checkbox" name="pan" {{#if pan}}checked{{/if}}
        {{#unless hasBackdrop}}disabled{{/unless}}> {{localize "STW.Backdrop.pan"}}</label>
      <span class="stw-spacer"></span>
      <button type="button" data-action="backdropOff" {{#unless hasBackdrop}}disabled{{/unless}}
        data-tooltip="{{localize "STW.Backdrop.offHint"}}"><i class="fa-solid fa-eye-slash" inert></i> {{localize "STW.Backdrop.off"}}</button>
      <button type="button" class="stw-primary" data-action="backdropAdd"
        data-tooltip="{{localize "STW.Backdrop.addHint"}}"><i class="fa-solid fa-plus" inert></i> {{localize "STW.Backdrop.add"}}</button>
    </div>
    {{#if backdrops.length}}
    <div class="stw-backdrop-strip">
      {{#each backdrops}}
      <article class="stw-backdrop-card{{#if active}} active{{/if}}" data-backdrop-id="{{id}}">
        <button type="button" class="stw-backdrop-pick" data-action="backdropShow" data-tooltip="{{name}}">
          <span class="stw-backdrop-thumb">{{{thumb}}}</span>
          <span class="stw-backdrop-name">{{name}}</span>
          {{#if audio}}<i class="fa-solid fa-music stw-backdrop-audio" inert></i>{{/if}}
          {{#if key}}<kbd>{{key}}</kbd>{{/if}}
        </button>
        <span class="stw-backdrop-tools">
          <button type="button" class="stw-icon" data-action="backdropEdit" data-tooltip="{{localize "STW.Backdrop.edit"}}"
            aria-label="{{localize "STW.Backdrop.edit"}}"><i class="fa-solid fa-pen" inert></i></button>
          <button type="button" class="stw-icon" data-action="backdropRemove" data-tooltip="{{localize "STW.Backdrop.remove"}}"
            aria-label="{{localize "STW.Backdrop.remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </article>
      {{/each}}
    </div>
    {{else}}
    <p class="stw-stage-hint">{{localize "STW.Backdrop.empty"}}</p>
    {{/if}}
  </section>

  {{#if empty}}
  <section class="stw-start">
    <i class="fa-solid fa-masks-theater stw-start-icon" inert></i>
    <h3>{{localize "STW.Stage.emptyTitle"}}</h3>
    <p>{{localize "STW.Stage.emptyText"}}</p>
  </section>
  {{else}}
  <div class="stw-stage-slots">
    {{#each slots}}
    <article class="stw-stagecard{{#if selected}} selected{{/if}}{{#if speaking}} speaking{{/if}}" data-slot-id="{{id}}" data-action="select">
      <div class="stw-stagecard-top">
        <div class="stw-stagecard-img">{{{imgHTML}}}</div>
        <div class="stw-stagecard-text">
          <strong>{{name}}</strong>
          {{#if real}}<small>{{real}}</small>{{/if}}
          <small class="stw-stagecard-expr">{{#if exprLabel}}{{exprLabel}}{{else}}{{sideLabel}}{{/if}}</small>
        </div>
        <div class="stw-stagecard-tools">
          <button type="button" class="stw-icon{{#if speaking}} on{{/if}}" data-action="speak"
            data-tooltip="{{localize "STW.Stage.speak"}}" aria-label="{{localize "STW.Stage.speak"}}" aria-pressed="{{#if speaking}}true{{else}}false{{/if}}"><i class="fa-solid fa-comment-dots" inert></i></button>
          <button type="button" class="stw-icon" data-action="flip"
            data-tooltip="{{localize "STW.Stage.flip"}} ({{sideLabel}})" aria-label="{{localize "STW.Stage.flip"}}"><i class="fa-solid fa-right-left" inert></i></button>
          <button type="button" class="stw-icon{{#if depthFar}} on{{/if}}" data-action="depth"
            data-tooltip="{{localize "STW.Stage.depthHint"}} ({{depthLabel}})" aria-label="{{localize "STW.Stage.depthHint"}}"><i class="fa-solid fa-layer-group" inert></i></button>
          <button type="button" class="stw-icon" data-action="remove"
            data-tooltip="{{localize "STW.Stage.remove"}}" aria-label="{{localize "STW.Stage.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
        </div>
      </div>
      <div class="stw-places" role="group" aria-label="{{localize "STW.Stage.placeHint"}}">
        {{#each places}}<button type="button" class="stw-place{{#if on}} on{{/if}}" data-action="place" data-place="{{value}}"
          aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
      </div>
      {{#if noOutfits}}
      <p class="stw-stage-hint">{{localize "STW.Stage.noOutfits"}}</p>
      {{else}}
      <div class="stw-outfit-strip">
        {{#each outfits}}
        <button type="button" class="stw-pick{{#if active}} active{{/if}}" data-action="express" data-outfit-id="{{id}}"
          data-tooltip="{{label}}{{#if mood}} ({{mood}}){{/if}}{{#if disguise}} / {{disguise}}{{/if}}">
          <span class="stw-pick-img">{{{thumb}}}</span>
          <span class="stw-pick-label">{{#if icon}}<i class="fa-solid {{icon}}" inert></i> {{/if}}{{label}}</span>
          {{#if key}}<kbd>{{key}}</kbd>{{/if}}
        </button>
        {{/each}}
      </div>
      {{/if}}
    </article>
    {{/each}}
  </div>
  {{/if}}

  <footer class="stw-foot"><i class="fa-regular fa-keyboard" inert></i> {{localize "STW.Stage.keys"}}</footer>
</div>
